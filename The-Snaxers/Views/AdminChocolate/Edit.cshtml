@model TheSnaxers.ViewModels.EditProductViewModel

@{
    ViewData["Title"] = "Redigera choklad";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h2 class="h4 mb-0">Redigera @Model.Name</h2>
                </div>
                <div class="card-body">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" name="originalCategory" value="@Model.Category" />
        <input type="hidden" asp-for="ImageUrl" />

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Produktnamn</label>
                    <input asp-for="Name" class="form-control shadow-sm" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Brand" class="form-label fw-bold">Varumärke</label>
                    <input asp-for="Brand" class="form-control shadow-sm" />
                    <span asp-validation-for="Brand" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-6 mb-3">
                        <label asp-for="Price" class="form-label fw-bold">Pris (kr)</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control shadow-sm" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="col-6 mb-3">
                        <label asp-for="CocoaPercentage" class="form-label fw-bold">Kakaohalt (%)</label>
                        <input asp-for="CocoaPercentage" type="number" class="form-control shadow-sm" />
                        <span asp-validation-for="CocoaPercentage" class="text-danger"></span>
                    </div>

                    <div class="col-6 mb-3">
                        <label asp-for="Weight" class="form-label fw-bold">Vikt (g)</label>
                        <input asp-for="Weight" type="number" class="form-control shadow-sm" />
                        <span asp-validation-for="Weight" class="text-danger"></span>
                    </div>

                    <div class="col-6 mb-3">
                        <label asp-for="StockLevel" class="form-label fw-bold">Antal i lager</label>
                        <input asp-for="StockLevel" type="number" class="form-control shadow-sm" min="0" />
                        <span asp-validation-for="StockLevel" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Country" class="form-label fw-bold">Ursprungsland</label>
                    <input asp-for="Country" class="form-control shadow-sm" />
                    <span asp-validation-for="Country" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label fw-bold">Kategori</label>
                    <select asp-for="Category" class="form-select shadow-sm">
                        <option value="">-- Välj kategori --</option>
                        <option value="Mörk Choklad">Mörk Choklad</option>
                        <option value="Ljus Choklad">Ljus Choklad</option>
                        <option value="Vit Choklad">Vit Choklad</option>
                        <option value="Smaksatt">Smaksatt</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Ladda upp produktbild</label>
                    <input type="file" name="imageFile" id="imageFile" class="form-control shadow-sm" accept="image/*" />
                    <span class="text-muted small">Välj en bild från din dator (max 2 MB, .jpg/.png/.webp).</span>
                    <span class="text-danger" id="fileSizeError"></span>

                    @if (ViewData["imageFileError"] != null)
                    {
                        <span class="text-danger d-block">@ViewData["imageFileError"]</span>
                    }
                </div>
            </div>

            <div class="col-12">
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Beskrivning</label>
                    <textarea asp-for="Description"
                              class="form-control shadow-sm"
                              rows="4"
                              placeholder="Berätta mer om chokladens karaktär..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="col-12">
                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-save2"></i> Spara ändringar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 shadow-sm">
                        <i class="bi bi-arrow-left-circle"></i> Tillbaka till listan
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @section Scripts {
                        <partial name="_ValidationScriptsPartial" />

                        <script>
                            $.validator.methods.number = function (value, element) {
                                return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:[\s,]\d{3})+)(?:[.,]\d+)?$/.test(value);
                            }

                            document.getElementById('imageFile').addEventListener('change', function () {
                                const maxSize = 2 * 1024 * 1024; // 2 MB
                                const errorEl = document.getElementById('fileSizeError');
                                if (this.files[0] && this.files[0].size > maxSize) {
                                    errorEl.textContent = 'Filen är för stor. Max 2 MB tillåts.';
                                    this.value = '';
                                } else {
                                    errorEl.textContent = '';
                                }
                            });
                        </script>
                    }