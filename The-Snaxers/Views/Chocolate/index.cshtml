@model IEnumerable<TheSnaxers.ViewModels.ChocolateGalleryViewModel>

@using TheSnaxers.Constants
@{
    ViewData["Title"] = "Chokladgalleriet";
}

@section Styles {
    <link rel="stylesheet" href="~/css/chocolate-gallery.css" asp-append-version="true" />
}

@* Hämta och lagra anti-forgery token för att skicka med i JavaScript-anrop *@
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<input id="antiForgeryToken" type="hidden" value="@token" />

<div class="container mt-4">
    <h1 class="text-center mb-5 display-4 shadow-text">Vårt Chokladutbud</h1>

    <form asp-controller="Chocolate" asp-action="Index" method="get" class="mb-4">
        <div class="row g-2">
            <div class="col-md-6">
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control"
                       placeholder="Sök på namn..." />
            </div>
            <div class="col-md-4">
                <select name="minCocoa" class="form-select">
                    <option value="">Alla kakaohalter</option>
                    <option value="50" selected="@(ViewBag.MinCocoa == 50)">50% eller mer</option>
                    <option value="70" selected="@(ViewBag.MinCocoa == 70)">70% eller mer</option>
                    <option value="85" selected="@(ViewBag.MinCocoa == 85)">85% eller mer</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-dark w-100">Sök</button>
            </div>
        </div>
    </form>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center my-5 p-5 border rounded bg-light">
            <img src="~/images/nochoc.png" alt="Ingen choklad hittades" class="mb-4"
                 style="max-width: 300px; opacity: 0.8;">
                <p class="lead text-muted">Ingen choklad hittades för tillfället.</p>
                <p>Kom gärna tillbaka senare eller kontakta vår chokladmästare.</p>
            </div>
        }
    else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var chocolate in Model)
                {
                    var isFavorite = ((List<string>)ViewBag.FavoriteIds)?.Contains(chocolate.Id) ?? false;
                    <div class="col">
                        <div class="flip-card" onclick="this.classList.toggle('flipped')">
                            <div class="flip-card-inner">

                                @* --- FRAMSIDA --- *@
                                <div class="flip-card-front card h-100 shadow-sm hover-shadow transition">
                                    <div class="position-relative">
                                        <img src="@chocolate.DynamicImageUrl" class="card-img-top choco-card-img"
                                             alt="@chocolate.Name" loading="lazy">

                                        @* Kakao-badge (Uppe till vänster) *@
                                        @if (chocolate.CocoaPercentage > 0)
                                        {
                                            <div class="position-absolute top-0 start-0 m-3 badge bg-dark fs-6 shadow-sm">
                                                @chocolate.CocoaPercentage% Kakao
                                            </div>
                                        }

                                        @* 🔴 NYTT: Slut i lager-badge på framsidan (så kunden ser direkt) *@
                                        @if (chocolate.StockLevel <= 0)
                                        {
                                            <div class="position-absolute top-0 end-0 m-3 badge bg-danger fs-6 shadow-sm">
                                                Slut i lager
                                            </div>
                                        }

                                        @* FLAGGAN OCH POPOVER (Nere till höger) *@
                                        <div class="position-absolute bottom-0 end-0 m-2 shadow-sm bg-white p-1 rounded country-wrapper"
                                             data-country-code="@chocolate.CountryCode" onclick="event.stopPropagation()">

                                            @if (!string.IsNullOrEmpty(chocolate.CountryCode) && chocolate.CountryCode.ToLower() !=
                                                                                                                                                                                                                "un")
                                            {
                                                <img src="https://flagcdn.com/w40/@(chocolate.CountryCode.ToLower()).png"
                                                     alt="@chocolate.CountryName" class="flag-badge" style="max-width: 30px;">
                                            }
                                            else
                                            {
                                                <span style="font-size:20px;">🌍</span>
                                            }
                                            <div class="country-popover">Laddar...</div>
                                        </div>
                                    </div>

                                    <div class="card-body d-flex flex-column p-3 text-start">
                                        <h5 class="card-title fw-bold">@chocolate.Name</h5>
                                        <p class="text-muted mb-3 small">Ursprung: @chocolate.CountryName</p>

                                        <div class="mt-auto d-flex justify-content-between align-items-center">
                                            <button class="btn btn-outline-primary btn-sm">Läs mer</button>

                                            @* 🟢 NYTT: Liten diskret lagerindikator på framsidan bredvid favorit-hjärtat *@
                                            @if (chocolate.StockLevel > 0 && chocolate.StockLevel <=
                                                                                                                                                                                                                InventoryConstants.LowStockThreshold)
                                            {
                                                <small class="text-warning fw-bold">Endast @chocolate.StockLevel kvar!</small>
                                            }

                                            <div class="favorite-zone" onclick="event.stopPropagation()">
                                                @if (User.Identity?.IsAuthenticated == true)
                                                {
                                                    <form asp-controller="Favorite" asp-action="@(isFavorite ? "Remove" : "Add")"
                                                          method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="productId" value="@chocolate.Id" />
                                                        <input type="hidden" name="returnUrl" value="Chocolate" />
                                                        <button type="submit"
                                                                class="btn btn-link p-0 text-decoration-none border-0 bg-transparent">
                                                            <i
                                                            class="bi @(isFavorite ? "bi-heart-fill" : "bi-heart") text-danger fs-4"></i>
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <a asp-area="Identity" asp-page="/Account/Login"
                                                           asp-route-returnUrl="/Favorite/Add?productId=@chocolate.Id&returnUrl=Chocolate"
                                                           class="btn btn-link p-0 text-decoration-none border-0 bg-transparent">
                                                        <i class="bi bi-heart text-danger fs-4"></i>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @* --- BAKSIDA --- *@
                                <div
                                    class="flip-card-back p-4 d-flex flex-column justify-content-center align-items-center text-center">
                                    <h5 class="fw-bold">@chocolate.Name</h5>

                                    @if (chocolate.CocoaPercentage > 0)
                                    {
                                        <span class="badge bg-light text-dark mb-2">🍫 @chocolate.CocoaPercentage% Kakao</span>
                                    }

                                    <p class="small">@chocolate.Description</p>
                                    <hr class="w-75 border-light">

                                    <p class="mb-1 small">✨ Märke: @(chocolate.Brand ?? "Snaxers Choice")</p>
                                    @if (chocolate.Weight > 0)
                                    {
                                        <p class="small">⚖️ Vikt: @chocolate.Weight g</p>
                                    }
                                    <p class="fw-bold fs-5 mt-2 text-snaxers-gold">@chocolate.Price kr</p>
                                
                                    @* 🔴 DYNAMISK LAGERSTATUS: Helt styrd av globala konstanter *@
                                    <p class="mb-2 small">
                                        Lagerstatus:
                                        @if (chocolate.StockLevel <= 0)
                                        {
                                            <strong class="text-danger bg-white px-1 rounded">Slut i lager</strong>
                                        }
                                        else if (chocolate.StockLevel <= InventoryConstants.LowStockThreshold)
                                        {
                                            <strong class="text-warning text-dark bg-white px-1 rounded">Få kvar (@chocolate.StockLevel
                                                st)</strong>
                                            }
                                        else if (chocolate.StockLevel <= InventoryConstants.MediumStockThreshold)
                                            {
                                                <strong class="text-info bg-white px-1 rounded">God tillgång (@chocolate.StockLevel
                                                    st)</strong>
                                                }
                                        else
                                                {
                                                    <strong class="text-success">@chocolate.StockLevel st i lager</strong>
                                                }
                                            </p>

                                            @* KÖPKNAPP — Nu inaktiverad om produkten är slut i lager *@
                                            @if (chocolate.StockLevel > 0)
                                            {
                                                @if (User.Identity?.IsAuthenticated == true)
                                                {
                                                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-2 w-100"
                                                          onclick="event.stopPropagation()">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="productId" value="@chocolate.Id" />
                                                        <input type="hidden" name="returnUrl"
                                                               value="@Context.Request.Path@Context.Request.QueryString" />
                                                        <button type="submit" class="btn btn-snaxers-gold w-100 shadow-sm fw-bold">
                                                            Lägg i korgen 🛒
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <a asp-area="Identity" asp-page="/Account/Login"
                                                           asp-route-returnUrl="/Cart/AddToCart?productId=@chocolate.Id&returnUrl=/Chocolate"
                                                           class="btn btn-outline-light w-100 mt-2 fw-bold" onclick="event.stopPropagation()">
                                                        Logga in för att köpa 🛒
                                                    </a>
                                                }
                                            }
                                            else
                                            {
                                                @* Visas om StockLevel är 0 *@
                                                <button class="btn btn-secondary w-100 mt-2 fw-bold" disabled onclick="event.stopPropagation()">
                                                    Slutsåld 💔
                                                </button>
                                            }

                                            <button class="btn btn-link btn-sm text-white mt-3 text-decoration-none">
                                                ← Tillbaka
                                            </button>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                <button type="button" class="btn btn-snaxers-gold btn-floating btn-lg" id="btn-back-to-top">
                    <i class="bi bi-arrow-up"></i>
                </button>
            </div>

            <script>
                // (Här ligger ditt JavaScript kvar precis som innan, orört!)
                document.addEventListener('DOMContentLoaded', function () {
                    const countryElements = document.querySelectorAll('[data-country-code]');

                    countryElements.forEach(el => {
                        el.addEventListener('mouseenter', async function () {
                            const code = this.getAttribute('data-country-code');
                            const popover = this.querySelector('.country-popover');

                            if (!code || code === "") {
                                if (popover) popover.innerHTML = "Ingen landskod hittades.";
                                return;
                            }

                            if (popover && popover.innerHTML === 'Laddar...') {
                                try {
                                    const token = document.getElementById('antiForgeryToken')?.value || '';

                                    const response = await fetch(`/api/country/${code}`, {
                                        method: 'GET',
                                        headers: {
                                            'Content-Type': 'application/json',
                                            'RequestVerificationToken': token
                                        }
                                    });

                                    if (!response.ok) throw new Error('Serverfel');
                                    const data = await response.json();

                                    popover.innerHTML = `
                                                                            <div style="padding: 5px;">
                                                                                <strong class="text-snaxers-gold">${data.name}</strong><br>
                                                                                <small class="text-muted">Visste du att...</small><br>
                                                                                <div class="mt-01">${data.fact}</div>
                                                                            </div>
                                                                        `;
                                } catch (error) {
                                    console.error("Fetch error:", error);
                                    popover.innerHTML = `
                                                                            <div style="padding: 5px; color: #b00020;">
                                                                                <small>⚠️ Oj!</small><br>
                                                                                <span>Kunde inte hämta fakta just nu.</span>
                                                                            </div>
                                                                        `;
                                    setTimeout(() => {
                                        if (popover.innerText.includes("Kunde inte hämta")) {
                                            popover.innerHTML = "Laddar...";
                                        }
                                    }, 3000);
                                }
                            }
                        });
                    });
                });

                document.addEventListener("DOMContentLoaded", () => {
                    const mybutton = document.getElementById("btn-back-to-top");

                    window.onscroll = function () {
                        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
                            mybutton.style.display = "block";
                        } else {
                            mybutton.style.display = "none";
                        }
                    };

                    mybutton.addEventListener("click", () => {
                        window.scrollTo({
                            top: 0,
                            behavior: 'smooth'
                        });
                    });
                });
            </script>