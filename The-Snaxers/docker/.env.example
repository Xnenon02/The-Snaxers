# Copy this file to .env and fill in the values
# Get values from team via secure channel (Discord)

# Azure Blob Storage
BLOB_CONNECTION_STRING=

# Azure Cosmos DB
COSMOS_ENDPOINT=
COSMOS_TENANT_ID=
COSMOS_DATABASE=
COSMOS_CONTAINER=
COSMOS_KEY=

# Admin credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google OAuth (valfritt — lämna tomt för att inaktivera Google-inloggning)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CosmosDB Cart-container (valfritt — lämna tomt för att använda InMemory-cart)
COSMOS_CART_CONTAINER=

# Application Insights (valfritt — lämna tomt för att inaktivera telemetri lokalt)
APP_INSIGHTS_CONNECTION_STRING=

# JWT signing secret for local API authentication
JWT_SECRET=